# No secrets are required. Default build downloads Whisper small (int8) and IndicConformer-TA ONNX weights.
SOLLICUT_ASR_ENGINE=faster-whisper
SOLLICUT_ASR_MODEL=small
SOLLICUT_ASR_DEVICE=cpu
SOLLICUT_ASR_COMPUTE_TYPE=int8
SOLLICUT_ASR_THREADS=4
SOLLICUT_INDIC_ASR_ENABLED=true
SOLLICUT_INDIC_MODEL_DIR=/models/indicconformer-ta
SOLLICUT_DATA_DIR=/data
SOLLICUT_PORT=8080
